# 로컬 실행용 환경변수 예시. 실제 값은 .env.local 에 두고 커밋하지 않는다(.gitignore).
# run-local.ps1 이 .env.local 을 읽어 환경변수로 올린 뒤 bootRun 한다.

# --- 실행 프로파일. local = H2 메모리 DB(설치 없이 바로 실행), dev = 로컬 MariaDB
SPRING_PROFILES_ACTIVE=local

# --- 포트. hrm(8082)·crm(8080)과 겹치지 않게 8083
SERVER_PORT=8083

# --- 자체 DB (dev/prod). 로컬 dev 는 반드시 localhost (스크립트가 그 외 호스트를 거부한다)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tara_common
DB_USERNAME=root
DB_PASSWORD=

# --- 관리 API(/api/admin/**) 토큰. 헤더 X-Admin-Token 으로 보낸다. 비우면 관리 API 전부 막힘.
#     생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_ADMIN_TOKEN=

# --- MS Graph 서비스계정 (Teams 1:1 메시지 발송). 네 개 중 하나라도 비면 발송 API 가 503.
#     hrm-module-api 의 .env.local 과 같은 값을 쓰면 된다.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_USERNAME=
MS_PASSWORD=

# --- 받는 사람으로 허용할 메일 도메인(쉼표)
APP_NOTIFY_ALLOWED_DOMAINS=taratps.com

# --- 서버 전체 접속 IP 제한. 비우면 제한 없음. 운영은 사내망/호출 서버 대역. 예: 10.0.0.0/8,203.0.113.5/32
APP_IP_ALLOWLIST=
# nginx 뒤에서만 true (X-Forwarded-For 신뢰). 로컬은 false.
APP_TRUST_PROXY=false

# --- Swagger (/swagger-ui.html). 운영은 false
APP_SWAGGER_ENABLED=true
